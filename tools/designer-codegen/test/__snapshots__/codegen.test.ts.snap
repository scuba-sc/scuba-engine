    scosdk::PanelBuilder panel;
    panel.Column([&] {
        panel.Button("Run diagnostics").Tooltip("Synthetic diagnostics only").Severity(1u);
        panel.Toggle("Telemetry", &v3);
        panel.Slider("Gain", &v4, 0.0, 1.0);
        panel.Row([&] {
            panel.Combo("Combo", &v6, {"Alpha", "Beta", "Gamma"});
            panel.TextInput("TextInput", &v7);
        });
        panel.Label("Synthetic instrument panel");
        panel.List("List", &v9, {"Alpha", "Beta", "Gamma"}).Paging(0u, 2u);
        panel.Table("Table", 2u, {"Item", "Status", "Probe", "Ready"}).Paging(0u, 1u);
    });
    return panel.Build();
}

namespace {
class DesignedPlugin final : public sco::sdk::Plugin {
