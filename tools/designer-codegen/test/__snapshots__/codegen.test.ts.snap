exports[`cpp full widgets 1.1 snapshots and parses instrument 1`] = `
"// scuba-panel {"id":"instrument","title":"Instrument control"}
#include "sco_api.h"
#include "sco_widgets.h"
#include <stddef.h>
#include "scosdk/scosdk.hpp"
#include "scosdk/menu_builder.hpp"
static bool v3 = false;
static double v4 = 0.5;
static scosdk::PanelTree BuildDesignedPanel() {
    scosdk::PanelBuilder panel;
    panel.Column([&] {
        panel.Button("Run diagnostics");
        panel.Toggle("Telemetry", &v3);
        panel.Slider("Gain", &v4, 0.0, 1.0);
    });
    return panel.Build();
}

namespace {
class DesignedPlugin final : public sco::sdk::Plugin {
public:
    sco_result OnLoad() override {
        if (widgets_.Open(*this) != SCO_OK) return SCO_OK;
        auto next = BuildDesignedPanel();
        if (!next) return next.Result();
        const auto result = next.Submit(widgets_, "instrument.main", "Instrument control");
        if (result == SCO_OK) tree_ = std::move(next);
        return result;
    }
    void OnUnload() override {
        if (widgets_) (void)widgets_.RemovePanel("instrument.main");
    }
private:
    sco::sdk::Widgets widgets_;
    scosdk::PanelTree tree_;
};
}
SCO_PLUGIN(DesignedPlugin, "instrument", "0.1.0", "the maintainer");
"
`;

