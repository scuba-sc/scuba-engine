exports[`c full widgets 1.1 snapshots and parses instrument 1`] = `
"// scuba-panel {"id":"instrument","title":"Instrument control"}
#include "sco_api.h"
#include "sco_widgets.h"
#include <stddef.h>

static const sco_widget_node_1_1 designed_nodes[] = {
    { .base = { .size = sizeof(sco_widget_node_1_1), .kind = SCO_WIDGET_COLUMN, .id = 1u, .parent = 0u, .flags = 0u, .label = "" }, .tooltip = "", .severity = 0u, .first_row = 0u, .visible_rows = 0u },
    { .base = { .size = sizeof(sco_widget_node_1_1), .kind = SCO_WIDGET_BUTTON, .id = 2u, .parent = 1u, .flags = 0u, .label = "Run diagnostics" }, .tooltip = "", .severity = 0u, .first_row = 0u, .visible_rows = 0u },
    { .base = { .size = sizeof(sco_widget_node_1_1), .kind = SCO_WIDGET_TOGGLE, .id = 3u, .parent = 1u, .flags = 0u, .label = "Telemetry", .value = 0.0 }, .tooltip = "", .severity = 0u, .first_row = 0u, .visible_rows = 0u },
    { .base = { .size = sizeof(sco_widget_node_1_1), .kind = SCO_WIDGET_SLIDER, .id = 4u, .parent = 1u, .flags = 0u, .label = "Gain", .value = 0.5, .minimum = 0.0, .maximum = 1.0 }, .tooltip = "", .severity = 0u, .first_row = 0u, .visible_rows = 0u },
};

static const sco_widgets_v1* designed_widgets;
static sco_plugin* designed_self;
static const sco_plugin_info designed_info = {
    sizeof(sco_plugin_info), SCO_API_MAJOR, SCO_API_MINOR, "instrument", "0.1.0", "the maintainer"
};
SCO_EXPORT const sco_plugin_info* sco_plugin_query(void) { return &designed_info; }
SCO_EXPORT sco_result sco_plugin_load(const sco_api* api, sco_plugin* self) {
    const void* table = NULL;
    designed_self = self;
    if (api->size < offsetof(sco_api, query_service) + sizeof(api->query_service) || !api->query_service)
        return SCO_OK;
    if (api->query_service(SCO_WIDGETS_NAME, SCO_WIDGETS_VERSION_1_0, &table) != SCO_OK || !table)
        return SCO_OK;
    designed_widgets = (const sco_widgets_v1*)table;
    if (designed_widgets->size < offsetof(sco_widgets_v1, remove_panel) + sizeof(designed_widgets->remove_panel) ||
        !designed_widgets->set_panel || !designed_widgets->remove_panel) {
        designed_widgets = NULL;
        return SCO_OK;
    }
    return designed_widgets->set_panel(self, "instrument.main", "Instrument control", &designed_nodes[0].base,
        4u, sizeof(designed_nodes[0]), NULL, NULL);
}
SCO_EXPORT void sco_plugin_unload(void) {
    if (designed_widgets) (void)designed_widgets->remove_panel(designed_self, "instrument.main");
    designed_widgets = NULL;
}
"
`;

