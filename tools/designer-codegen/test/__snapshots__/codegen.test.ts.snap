exports[`csharp published builder subset snapshots and roundtrips actual supported calls 1`] = `
"// scuba-panel {"id":"instrument","title":"Instrument control"}
using Sco.Sdk;

public static class DesignedPanel {
    public static (WidgetNode[] Nodes, PanelBuilder Builder) Build() {
    var panel = new PanelBuilder();
    panel.Column(1u, scope1 => {
        panel.Button(2u, "Run diagnostics", disabled: false);
        panel.Toggle(3u, "Telemetry", false, disabled: false);
        panel.Slider(4u, "Gain", 0.5, 0.0, 1.0, disabled: false);
        panel.Row(5u, scope5 => {
            panel.Button(6u, "Button", disabled: false);
        }, disabled: true);
    }, disabled: false);
    return (panel.Build(), panel);
    }
}
"
`;

exports[`lua published builder subset snapshots and roundtrips actual supported calls 1`] = `
"-- scuba-panel {"id":"instrument","title":"Instrument control"}
local panel = sco.panel_builder.new()
    panel:column(function(panel)
        panel:button({ label = "Run diagnostics", disabled = false })
        panel:toggle({ label = "Telemetry", disabled = false, value = false })
        panel:slider({ label = "Gain", disabled = false, value = 0.5, minimum = 0.0, maximum = 1.0 })
        panel:row(function(panel)
            panel:button({ label = "Button", disabled = false })
        end, { disabled = true })
    end, { disabled = false })
local nodes, dispatch = panel:build()
return nodes, dispatch
"
`;
