if(NOT DEFINED TEST_EXECUTABLE OR NOT DEFINED MARKER)
  message(FATAL_ERROR "TEST_EXECUTABLE and MARKER are required")
endif()

file(REMOVE "${MARKER}")
execute_process(COMMAND "${TEST_EXECUTABLE}" "${MARKER}" RESULT_VARIABLE _result)
if(NOT EXISTS "${MARKER}")
  message(FATAL_ERROR "the child did not complete startup before Stop()")
endif()
file(READ "${MARKER}" _started)
file(REMOVE "${MARKER}")
if(NOT _started STREQUAL "started")
  message(FATAL_ERROR "the child startup marker is invalid")
endif()
if(NOT "${_result}" MATCHES "^[0-9]+$" OR _result EQUAL 0)
  message(FATAL_ERROR "Stop() did not fail-stop after injected core failure (result=${_result})")
endif()
